# Copy to .env for local development. Both values are public: the publishable
# (or legacy anon) key is designed to ship in the browser. Never put the
# service_role key or a database password here.
#
# Supabase dashboard → Project Settings → API:
# Use the Project URL and the Publishable key (or the legacy anon public key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
